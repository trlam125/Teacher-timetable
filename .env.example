# PostgreSQL 14+; thay user, password, host, port và database theo máy của bạn.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/teacher_timetable

# AI Studio: tạo bảng bằng lệnh migrate riêng sau khi xác nhận DB và backup.
AI_SLIDES_ENABLED=false
AI_SLIDES_OPENROUTER_API_KEY=
AI_SLIDES_PRIMARY_MODEL=
AI_SLIDES_FALLBACK_MODELS=
AI_SLIDES_AI_STEP_TIMEOUT_SECONDS=85
# Mọi lần gọi, kể cả lỗi và chỉnh từng slide, đều tính vào hạn mức UTC.
AI_SLIDES_MAX_REQUESTS_PER_USER_DAY=8
AI_SLIDES_MAX_REQUESTS_SERVER_DAY=40

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# production: không bao giờ hiển thị link đặt lại mật khẩu trên web.
# development: chỉ hiển thị link kiểm thử khi truy cập localhost/127.0.0.1.
APP_ENV=production

# URL gốc công khai của backend/web. Backend dùng URL này để tạo link email/chia sẻ.
# Gradle Android cũng đọc giá trị này từ .env khi build APK (có thể override bằng
# biến môi trường hoặc -PAPP_BASE_URL=...). Production phải dùng HTTPS.
APP_BASE_URL=

# Thời hạn phiên đăng nhập phía máy chủ, tính bằng giây. Mặc định 12 giờ.
SESSION_TTL_SECONDS=43200

# Chặn sớm trước khi parse body/truy vấn DB. Các ngưỡng bộ nhớ áp dụng mỗi worker.
# 32 MiB cho phép một file 15 MiB kèm report JSON và multipart overhead.
HTTP_MAX_BODY_BYTES=33554432
HTTP_BODY_TIMEOUT_SECONDS=30
HTTP_RATE_PER_MINUTE=600
HTTP_RATE_BURST=120
HTTP_MAX_CONCURRENT=64
# Slot riêng cho body >64 KiB/không rõ kích thước; form nhỏ không bị chiếm slot này.
HTTP_MAX_BODY_CONCURRENT=4
WS_MAX_CONNECTIONS=128
# Giới hạn tài khoản dùng bảng presence và khóa PostgreSQL, chia sẻ giữa workers.
WS_MAX_CONNECTIONS_PER_USER=8
WS_MAX_CONNECTIONS_PER_IP=16
WS_MAX_MESSAGE_BYTES=32768
WS_EVENTS_PER_MINUTE=120
WS_EVENT_BURST=30
# Cấu hình qua môi trường tiến trình Uvicorn, chỉ tin IP/CIDR proxy thực sự.
# Không đặt * khi backend còn truy cập trực tiếp từ Internet.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Tài khoản duy nhất giữ role super_admin và dùng để bootstrap hệ thống.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ID user duy nhất giữ super_admin sau khi hệ thống đã có dữ liệu.
# Để trống ở database mới; sau khi bootstrap có thể đặt ID ổn định tại đây.
SUPER_ADMIN_USER_ID=

# true chỉ khi muốn tạo thêm project và dữ liệu minh họa ở lần khởi tạo đầu tiên.
SEED_DEMO_DATA=false

# Chỉ dùng khi cần nâng cấp project demo rất cũ từ 1 buổi lên 2 buổi.
# Điền chính xác project_id, có thể nhiều ID ngăn cách bằng dấu phẩy.
# Để trống trong vận hành bình thường để không tự thay đổi dữ liệu project.
LEGACY_DEMO_SESSION_EXPANSION_PROJECT_IDS=

# Gửi email tự động theo môi trường:
# - Render: gọi Netlify Mail Proxy qua HTTPS; proxy gửi Gmail SMTP.
# - Local/VPS/server khác: dùng SMTP trực tiếp.
EMAIL_FROM_NAME=Smart TKB
EMAIL_HTTP_TIMEOUT_SECONDS=20

# Render -> Netlify Mail Proxy. Hai giá trị này chỉ cần cấu hình trên Render.
# MAIL_API_URL là endpoint sau khi deploy thư mục netlify-mail-proxy lên Netlify.
# MAIL_API_SECRET phải là chuỗi bí mật dài, giống hệt giá trị trên Netlify.
MAIL_API_URL=https://your-mail-proxy.netlify.app/api/send-email
MAIL_API_SECRET=

# SMTP dùng trực tiếp cho local/VPS/server không bị chặn cổng SMTP.
# Cùng các biến này được cấu hình trên project Netlify Mail Proxy để proxy gửi mail.
# Với Gmail: bật Xác minh 2 bước rồi tạo App Password 16 ký tự.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=30

# Chatbot phân công và phân tích thời khóa biểu qua NVIDIA API. Chỉ lưu key ở backend.
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
# Dự phòng được NVIDIA Build liệt kê Free Endpoint; dùng tên model phân cách bằng dấu phẩy.
# Để trống NVIDIA_FALLBACK_MODELS nếu muốn tắt fallback.
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b
# Giới hạn mỗi lần sinh phản hồi; 4096 giúp tránh output quá dài gây timeout.
NVIDIA_MAX_OUTPUT_TOKENS=4096
# Retry 429/5xx, lỗi mạng nhanh; không lặp một request đã timeout 45 giây,
# và chuyển model ngay nếu gặp HTTP 404/410.
NVIDIA_ATTEMPTS_PER_MODEL=2
NVIDIA_RETRY_BASE_SECONDS=0.8
NVIDIA_RETRY_MAX_SECONDS=4
# Đăng nhập Google. Chi tiết: docs/SOCIAL_LOGIN.md.
# APP_BASE_URL phải là origin backend chính xác (không có path và không là Vercel launcher).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
