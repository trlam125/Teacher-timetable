# PostgreSQL 14+; thay user, password, host, port và database theo máy của bạn.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/teacher_timetable

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# production: không bao giờ hiển thị link đặt lại mật khẩu trên web.
# development: chỉ hiển thị link kiểm thử khi truy cập localhost/127.0.0.1.
APP_ENV=production

# URL công khai cố định dùng trong email đặt lại mật khẩu. Bắt buộc ở production.
# Không lấy URL từ Host header của request để tránh tạo link giả mạo.
APP_BASE_URL=https://tkb.example.com

# Thời hạn phiên đăng nhập phía máy chủ, tính bằng giây. Mặc định 12 giờ.
SESSION_TTL_SECONDS=43200

# Tài khoản duy nhất giữ role super_admin và dùng để bootstrap hệ thống.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ID user duy nhất giữ super_admin sau khi hệ thống đã có dữ liệu.
# Để trống ở database mới; sau khi bootstrap có thể đặt ID ổn định tại đây.
SUPER_ADMIN_USER_ID=

# true chỉ khi muốn tạo thêm project và dữ liệu minh họa ở lần khởi tạo đầu tiên.
SEED_DEMO_DATA=false

# Cấu hình SMTP để chức năng quên mật khẩu gửi email thật.
# Với Gmail: bật Xác minh 2 bước rồi tạo App Password 16 ký tự.
# KHÔNG dùng mật khẩu Gmail thông thường và KHÔNG commit file .env lên GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=30
